# tawk.to live chat — from Administration → Channels → Chat Widget
# Widget code URL looks like: https://embed.tawk.to/PROPERTY_ID/WIDGET_ID
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=default

# Contact form — get a free access key at https://web3forms.com
# Use inbox email: info@neutrixlab.com when creating the key
VITE_WEB3FORMS_ACCESS_KEY=
VITE_CONTACT_EMAIL=info@neutrixlab.com
VITE_SITE_URL=https://neutrixlab.com
